<section class="vcs-portal" aria-labelledby="portal_title">
  <h1 id="portal_title">Valley Christian Sign</h1>
  <p class="vcs-portal-description">Document signing for Valley Christian Schools.</p>
  <div class="vcs-portal-options">
    <div>
      <h2>Prepare and send documents</h2>
      <p>Sign in to manage templates, send signing requests, and follow each document's progress.</p>
      <%= link_to t('sign_in'), new_user_session_path, class: 'base-button' %>
    </div>
    <div>
      <h2>Complete a document</h2>
      <p>Open the signing link in your invitation to review and complete your document. You do not need a staff account.</p>
    </div>
  </div>
</section>
