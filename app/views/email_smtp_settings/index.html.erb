<%= render 'shared/html_title', title: 'Email delivery' %>
<% content_for(:native_title, 'Email delivery') if turbo_native_app? %>
<% resend_config = @resend_config || EncryptedConfig.find_or_initialize_by(account: current_account, key: 'resend_api') %>
<% resend_value = resend_config.value || {} %>
<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-xl mx-auto min-w-0">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Email delivery</h1>
    <p class="vcs-form-description">Send document invitations, reminders, and completed copies from Valley Christian Sign.</p>
    <section aria-labelledby="resend_heading">
      <h2 id="resend_heading" class="vcs-settings-heading">Resend</h2>
      <p class="vcs-field-help mb-4">The preferred email provider for this workspace.</p>
      <% if resend_value['api_key'].present? %>
        <p class="vcs-configuration-status">Resend API key saved</p>
      <% end %>
      <%= form_with url: settings_email_index_path, scope: :resend_api, method: :post, html: { autocomplete: 'off', class: 'space-y-4' } do |f| %>
        <div class="form-control">
          <%= f.label :api_key, 'Resend API key', class: 'label' %>
          <%= f.password_field :api_key, value: '', required: resend_value['api_key'].blank?, autocomplete: 'new-password', class: 'base-input w-full', aria: { describedby: 'resend_key_help' } %>
          <p id="resend_key_help" class="vcs-field-help"><%= resend_value['api_key'].present? ? 'A key is saved. Leave this field blank to keep it, or enter a new key to replace it.' : 'Enter your Resend API key. The saved key will not be displayed.' %></p>
        </div>
        <div class="form-control">
          <%= f.label :from_email, 'Sender email address', class: 'label' %>
          <%= f.email_field :from_email, value: resend_value['from_email'].presence || 'sign@valleychristianai.com', required: true, class: 'base-input w-full', aria: { describedby: 'resend_from_help' } %>
          <p id="resend_from_help" class="vcs-field-help">Use an address on a domain verified in your Resend account.</p>
        </div>
        <div class="form-control pt-2">
          <%= f.button button_title(title: 'Save Resend settings', disabled_with: t('saving')), class: 'base-button' %>
        </div>
      <% end %>
    </section>
    <details class="vcs-settings-details">
      <summary>SMTP fallback</summary>
      <div class="vcs-settings-details-body">
        <p class="vcs-form-description">Configure a traditional mail server for use when Resend is not configured.</p>
        <%= render 'smtp_form' %>
      </div>
    </details>
  </div>
  <div class="w-0 lg:w-52"></div>
</div>
