<meta name="vcs-embed-token" content="<%= params[:token] %>">
<script src="/vcs-embed-builder.js" defer></script>
<template-builder class="grid" data-with-custom-fields="false" data-fetch-headers="<%= { 'X-VCS-Embed-Token' => params[:token] }.to_json %>" data-template="<%= @template_data.to_json %>" data-locale="<%= I18n.locale %>" data-with-conditions="true" data-with-formula="true" data-with-fields-detection="true" data-with-send-button="false" data-with-sign-yourself-button="false" data-with-revisions-menu="true" data-accept-file-types="image/*, application/pdf, application/zip, application/json, <%= Templates::CreateAttachments.document_extensions.join(', ') %>"></template-builder>
