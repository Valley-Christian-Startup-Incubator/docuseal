<div class="vcs-logo-settings">
  <p class="vcs-form-description">Use a custom logo on your workspace and signing pages. Without a custom logo, the Valley Christian Schools logo is shown.</p>
  <% if current_account.logo.attached? %>
    <div class="vcs-logo-preview">
      <%= image_tag ActiveStorage::Blob.proxy_path(current_account.logo.blob, expires_at: 1.hour.from_now.to_i), alt: "#{current_account.name} logo" %>
    </div>
  <% end %>
  <%= form_with url: settings_account_logo_path, method: :post, multipart: true, data: { turbo: false }, html: { class: 'space-y-4' } do |f| %>
    <div class="form-control">
      <%= f.label :logo, current_account.logo.attached? ? 'Replace logo' : 'Upload logo', class: 'label' %>
      <%= f.file_field :logo, name: 'logo', accept: 'image/png,image/jpeg,image/webp', required: true, class: 'vcs-logo-file', aria: { describedby: 'logo_upload_help' } %>
      <p id="logo_upload_help" class="vcs-field-help">PNG, JPEG, or WebP. Maximum file size: 2 MB. Keep the original proportions and artwork.</p>
    </div>
    <%= f.button button_title(title: 'Save logo', disabled_with: t('saving')), class: 'base-button' %>
  <% end %>
  <% if current_account.logo.attached? %>
    <div class="mt-4">
      <%= button_to 'Restore school logo', settings_account_logo_path, method: :delete, class: 'btn btn-outline', data: { turbo_confirm: 'Remove the custom logo and restore the Valley Christian Schools logo?' } %>
    </div>
  <% end %>
</div>
